// =============================================================================
// version.h - 程序版本与仓库信息（由 CMake 从 project() 与顶层变量生成）
//
// 统一配置入口：版本号、仓库 owner/name 均在 CMakeLists.txt 顶部定义，
// 其他地址类宏在此派生，代码里不要再硬编码项目链接。
// =============================================================================
#pragma once

#define APP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define APP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define APP_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define APP_VERSION_STRING L"@PROJECT_VERSION@"
#define APP_VERSION_UTF8 "@PROJECT_VERSION@"

// 程序显示名称（关于页/更新提示使用；倒计时标题仍是用户配置项）
#define APP_NAME    L"\u5012\u8ba1\u65f6"
#define APP_NAME_EN L"Countdown"

// 仓库信息
#define APP_REPO_OWNER L"@APP_REPO_OWNER@"
#define APP_REPO_NAME  L"@APP_REPO_NAME@"
#define APP_REPO_URL   L"https://github.com/@APP_REPO_OWNER@/@APP_REPO_NAME@"

// 发布页与最新版本 API（检查更新使用）
#define APP_REPO_RELEASES_URL APP_REPO_URL L"/releases"
#define APP_REPO_LATEST_API   L"https://api.github.com/repos/@APP_REPO_OWNER@/@APP_REPO_NAME@/releases/latest"

// 附件下载镜像前缀：拼接在原始 GitHub 链接之前即可加速下载
#define APP_MIRROR_PREFIX L"@APP_MIRROR_PREFIX@"
